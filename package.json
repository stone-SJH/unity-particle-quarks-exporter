{
  "name": "unity-particle-quarks-exporter",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w unity-particle-quarks-runtime",
    "typecheck": "npm run typecheck -w unity-particle-quarks-runtime",
    "test": "npm run test -w unity-particle-quarks-runtime",
    "verify:browser": "node scripts/verify-browser-runtime.mjs",
    "verify:package-install": "node scripts/verify-package-install.mjs",
    "verify:runtime-load": "node scripts/verify-runtime-load.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/three": "0.185.1",
    "playwright": "1.60.0",
    "three": "0.185.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
