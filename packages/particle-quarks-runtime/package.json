{
  "name": "unity-particle-quarks-runtime",
  "version": "0.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stone-SJH/unity-particle-quarks-exporter.git",
    "directory": "packages/particle-quarks-runtime"
  },
  "homepage": "https://github.com/stone-SJH/unity-particle-quarks-exporter/tree/main/packages/particle-quarks-runtime",
  "bugs": "https://github.com/stone-SJH/unity-particle-quarks-exporter/issues",
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/vfx.js",
  "module": "./dist/vfx.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vfx.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "quarks.core": "0.17.1",
    "three.quarks": "0.17.1"
  },
  "peerDependencies": {
    "three": ">=0.182.0 <0.186.0"
  }
}
